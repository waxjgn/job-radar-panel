# 打工避雷平台 —— 环境配置样板
# 部署面板会按你在面板里的选择重新生成这份文件（真正的文件是项目根目录的 .env）

# 运行环境：development / production
FLASK_ENV=development

# 应用监听
APP_PORT=5000
APP_BIND=127.0.0.1
APP_DOMAIN=localhost
SITE_NAME=打工避雷平台

# 会话签名密钥：上线前务必换成随机串
SECRET_KEY=change-me-in-production

# 数据库：sqlite / mysql
DB_ENGINE=sqlite
SQLITE_PATH=data/app.db
# 选择 mysql 时填写下面几项
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=dgbilei

# 视频域名白名单（逗号分隔，面板里可可视化增删）
VIDEO_ALLOWLIST=bilibili.com,douyin.com,kuaishou.com,channels.weixin.qq.com
PROXY_IMAGES=true

# 安全开关
ENABLE_CAPTCHA=true
CAPTCHA_PROVIDER=builtin
ENABLE_CONTENT_REVIEW=true
ENABLE_RATE_LIMIT=true
RATE_LIMIT_PER_MIN=10
